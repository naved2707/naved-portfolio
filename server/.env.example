NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Use the exact trusted reverse-proxy count for your host; do not blindly use 1.
TRUST_PROXY_HOPS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Bare email addresses; EMAIL_FROM must be authorized by your SMTP provider.
EMAIL_FROM=
EMAIL_TO=
