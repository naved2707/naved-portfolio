# Public frontend settings. These values are included in the browser bundle.
# Optional override for the public Web3Forms submission key in portfolioData.js.
# This is visible in the browser. Never use a Gmail password or secret API key.
VITE_WEB3FORMS_ACCESS_KEY=
# Used only when portfolio.contact.provider is set to 'server'.
VITE_CONTACT_ENDPOINT=
# Local email service example: http://localhost:3001/api/contact
# Canonical public origin, with no path or trailing slash. Empty omits canonical/sitemap.
VITE_SITE_URL=
